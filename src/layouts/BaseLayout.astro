---
// Every public page renders through this layout. It enforces the page
// metadata contract (PLAN.md §5.1) and writes the metadata to <body data-*>,
// which is the only place the simulation reads it from.
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { assertPageMeta } from '../lib/taxonomy.js';
import facts from '../../content/facts.json';

interface Props {
  title: string;
  description: string;
  section: string;
  audience: string;
  program?: string;
  topic?: string;
  personaHook?: string;
}

const { title, description, section, audience, program, topic, personaHook } = Astro.props;
assertPageMeta({ section, audience }, Astro.url.pathname);
const fullTitle = section === 'home' ? `${facts.name} | Home` : `${title} | ${facts.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/demo-config.js"></script>
  </head>
  <body
    data-section={section}
    data-audience={audience}
    data-program={program}
    data-topic={topic}
    data-persona-hook={personaHook}
    data-sim="on"
    data-sim-badge="on"
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <Header section={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
