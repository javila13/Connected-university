---
// Companion inspector window for dual-screen demos (PLAN.md §5.6, D11). The
// same views as the drawer, all on one screen, updating live as the visitor
// clicks around the site in another window. It only reads the profile; it
// never records anything.
import ToolLayout from '../layouts/ToolLayout.astro';
import { getSimCatalog } from '../lib/sim-catalog.js';
import '../../sim/inspector.css';

const simCatalog = JSON.stringify(await getSimCatalog()).replace(/</g, '\\u003c');
---
<ToolLayout title="Data 360 companion">
  <header class="tool-header">
    <h1>Data 360 · Companion view</h1>
    <span class="pill pill--warn sim-pill">Simulated</span>
    <span class="spacer"></span>
    <span class="pill" id="who">Anonymous visitor</span>
    <span class="pill" id="sync" aria-live="polite">Live</span>
  </header>
  <main class="tool-main d360 d360-companion">
    <p class="d360-note" id="paused" hidden>The simulation is switched off in /demo. Nothing new is being recorded.</p>
    <section class="d360-card" aria-labelledby="c-profile"><h2 id="c-profile">Profile</h2><div data-view="profile"></div></section>
    <section class="d360-card" aria-labelledby="c-affinities"><h2 id="c-affinities">Affinities</h2><div data-view="affinities"></div></section>
    <section class="d360-card" aria-labelledby="c-engagement"><h2 id="c-engagement">Engagement</h2><div data-view="engagement"></div></section>
    <section class="d360-card" aria-labelledby="c-identity"><h2 id="c-identity">Identity</h2><div data-view="identity"></div></section>
    <section class="d360-card d360-card--wide" aria-labelledby="c-decisions"><h2 id="c-decisions">Personalization decisions</h2><div data-view="decisions"></div></section>
  </main>
  <script type="application/json" id="cu-sim-catalog" set:html={simCatalog} />
</ToolLayout>

<style is:global>
  .d360-companion {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .d360-companion .d360-note {
    grid-column: 1 / -1;
    margin: 0;
  }
  .d360-card {
    background: #fff;
    border: 1px solid var(--d360-border);
    border-radius: 6px;
    padding: 0.9rem 1rem 1rem;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
  }
  .d360-card h2 {
    font-size: 15px;
    margin: 0 0 0.6rem;
  }
  .d360-card--wide {
    grid-column: 1 / -1;
    max-height: 420px;
  }
  @media (max-width: 900px) {
    .d360-companion {
      grid-template-columns: minmax(0, 1fr);
    }
    .d360-card {
      max-height: none;
    }
  }
</style>

<script>
  import * as store from '../../sim/store.js';
  import { profileView, engagementView, affinitiesView, identityView, decisionsView } from '../../sim/views.js';
  import { displayName, STAGES } from '../../sim/identity.js';
  import { getSettings, onSettingsChange } from '../scripts/settings.js';

  let catalog = {};
  try {
    catalog = JSON.parse(document.getElementById('cu-sim-catalog')?.textContent || '{}');
  } catch {}

  const views = { profile: profileView, engagement: engagementView, affinities: affinitiesView, identity: identityView, decisions: decisionsView };
  const firstSeen = new Map(store.getState().events.map((e) => [e.id, 0]));
  const who = document.getElementById('who')!;
  const sync = document.getElementById('sync')!;
  const paused = document.getElementById('paused')!;
  const badge = document.querySelector<HTMLElement>('.sim-pill')!;

  function render(live = false) {
    const state = store.getState();
    const now = Date.now();
    for (const e of state.events) if (!firstSeen.has(e.id)) firstSeen.set(e.id, now);
    const isNew = (id: string) => now - (firstSeen.get(id) ?? 0) < 2000;
    for (const el of document.querySelectorAll<HTMLElement>('[data-view]')) {
      el.innerHTML = views[el.dataset.view as keyof typeof views](state, { isNew, catalog });
    }
    const id = state.identity;
    who.textContent = !id?.known
      ? 'Anonymous visitor'
      : `${displayName(id)} · ${id.personId === 'sofia' ? STAGES[id.stage] : 'New contact'}`;
    if (live) sync.textContent = `Updated ${new Date().toLocaleTimeString()}`;
    const s = getSettings();
    badge.hidden = !s.simulatedBadge;
    paused.hidden = s.simulation;
  }

  store.startSync();
  store.subscribe(() => render(true));
  onSettingsChange(() => render());
  render();
</script>
