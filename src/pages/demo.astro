---
// Demo control panel (PLAN.md §7). Presenter-only: noindex, no site chrome.
// Settings persist to localStorage and reach open site tabs via BroadcastChannel.
import ToolLayout from '../layouts/ToolLayout.astro';
import { AUDIENCES, AGENT_PERSONAS } from '../lib/taxonomy.js';
import { getSimCatalog } from '../lib/sim-catalog.js';
import sofia from '../../content/sofia.json';
import { WEIGHTS } from '../../sim/config.js';
import { TUNABLE_RULES } from '../scripts/settings.js';

const stages = Object.entries(sofia.stages).map(([id, s]) => ({ id, label: s.label }));
const presetLabels: Record<string, string> = { prospect: 'Sofia · Prospect', student: 'Sofia · Student', alumna: 'Sofia · Alumna/Donor', learner: 'Sofia · Learner' };
const simCatalog = JSON.stringify(await getSimCatalog()).replace(/</g, '\\u003c');

// Affinity tuner rows (PLAN.md §5.3, §7).
const WEIGHT_LABELS: Record<string, string> = {
  PAGE_VIEW: 'Page view',
  CLICK: 'Click on a call to action',
  FORM_START: 'Form start',
  FORM_SUBMIT: 'Form submit',
  DWELL: '30 seconds engaged on a page',
  AGENT_INTERACTION: 'Question to the agent',
};
const weightRows = Object.entries(WEIGHTS).map(([key, dflt]) => ({ key, dflt, label: WEIGHT_LABELS[key] ?? key }));
const ZONE_LABELS: Record<string, string> = {
  'pz-home-hero': 'Home hero',
  'pz-recommended-programs': 'Program lists',
  'pz-giving-cta': 'Giving band',
  'pz-next-credential': 'Certificates tile',
};
const signalLabel = (w: any) =>
  w.topAffinity === 'certificate'
    ? 'top certificate interest'
    : w.topAffinity
      ? 'top academic interest'
      : `${w.affinity.split(':')[1].replace(/-/g, ' ')} interest`;
const thresholdRows = TUNABLE_RULES.map((r: any) => ({
  id: r.id,
  dflt: r.when.minScore,
  zone: ZONE_LABELS[r.zone] ?? r.zone,
  variant: r.variant,
  signal: signalLabel(r.when),
}));
---
<ToolLayout title="Demo control panel">
  <header class="tool-header">
    <h1>Connected University · Demo control panel</h1>
    <span class="spacer"></span>
    <a class="slds-btn" href="/" id="back-link">← Back to site</a>
    <a class="slds-btn" href="/data360/" target="cu-data360" data-open-companion>Open /data360</a>
  </header>

  <main class="tool-main">
    <div class="status" role="status" aria-live="polite" id="status"></div>

    <section class="card">
      <h2>Experience</h2>
      <p class="help">Saved in this browser and applied live to every open site tab.</p>
      <div class="controls">
        <label class="switch">
          <input type="checkbox" data-setting="simulation" />
          <span><strong>Simulation</strong> · Data 360 tracking, personalization and the Agentforce mock</span>
          <span class="pill pill--warn" data-override-for="simulation" hidden>URL override</span>
        </label>

        <label class="switch">
          <input type="checkbox" data-setting="agentforce" />
          <span><strong>Agentforce mock</strong> · a chat agent bottom-right on every page, matched to the page's audience. Off by default. The site doesn't load Piper; presenters add it with a Chrome extension</span>
          <span class="pill pill--warn" data-override-for="agentforce" hidden>URL override</span>
        </label>

        <label class="select">
          <span><strong>Agent persona</strong> <span class="pill pill--warn" data-override-for="agentPersona" hidden>URL override</span></span>
          <select data-setting="agentPersona">
            <option value="auto">Auto (by page audience)</option>
            {Object.entries(AGENT_PERSONAS).map(([id, name]) => <option value={id}>{name}</option>)}
          </select>
        </label>

        <label class="switch">
          <input type="checkbox" data-setting="consentAutoAccept" />
          <span><strong>Consent auto-accept</strong> · skip the cookie banner. On by default</span>
          <span class="pill pill--warn" data-override-for="consentAutoAccept" hidden>URL override</span>
        </label>

        <label class="switch">
          <input type="checkbox" data-setting="simulatedBadge" />
          <span><strong>"Simulated" badge</strong> · on the inspector, the Agentforce mock and "Why am I seeing this?". Off by default</span>
          <span class="pill pill--warn" data-override-for="simulatedBadge" hidden>URL override</span>
        </label>

        <label class="switch">
          <input type="checkbox" data-setting="showWhy" />
          <span><strong>"Why am I seeing this?"</strong> · a button on each personalized zone that explains the rule behind it. Off by default</span>
          <span class="pill pill--warn" data-override-for="showWhy" hidden>URL override</span>
        </label>

        <label class="switch">
          <input type="checkbox" data-setting="showGrounding" />
          <span><strong>"Grounded in Data 360" notes</strong> · under the Agentforce mock's answers, listing the profile signals each answer used. Off by default</span>
          <span class="pill pill--warn" data-override-for="showGrounding" hidden>URL override</span>
        </label>
      </div>
      <p><button type="button" class="slds-btn" data-action="reset-settings">Restore defaults</button></p>
    </section>

    <section class="card">
      <h2>Agent routing preview</h2>
      <p class="help">What each page audience shows with the current settings (once consent is given).</p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Audience</th><th>Agentforce mock</th><th>Agent persona</th></tr></thead>
          <tbody id="routing">
            {AUDIENCES.map((a) => <tr data-audience={a}><td>{a}</td><td></td><td></td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2>Visitor</h2>
      <p class="help">
        Current visitor: <span class="pill" id="visitor-state">–</span> · Consent: <span class="pill" id="consent-state">–</span>
      </p>
      <div class="buttons">
        <button type="button" class="slds-btn slds-btn--brand" data-action="reset-visitor">Reset visitor</button>
        <button type="button" class="slds-btn" data-action="clear-consent">Clear consent only</button>
      </div>
      <p class="help">Reset clears the simulated profile and the consent cookie. Settings are kept.</p>

      <fieldset class="radio-group">
        <legend><strong>Identity matching</strong> <span class="pill pill--warn" data-override-for="identityMatching" hidden>URL override</span></legend>
        <label><input type="radio" name="identityMatching" value="sofia" /> <span><b>Always Sofia</b> · any email on a form opens Sofia's profile, so every story beat works (default)</span></label>
        <label><input type="radio" name="identityMatching" value="typed" /> <span><b>Match typed email</b> · Sofia's email opens her profile; any other email creates a new contact with only what was typed (no CRM history)</span></label>
      </fieldset>

      <h3 class="sub">Become Sofia</h3>
      <p class="help">Stitches the current visitor, and everything they've done so far, to Sofia Sanders at the life stage you pick. Use it after browsing anonymously. If the visitor is already a new contact (Match typed email), Reset visitor first.</p>
      <div class="buttons">
        <label class="select inline">
          <span class="visually-hidden">Life stage</span>
          <select id="become-stage">
            {stages.map((s) => <option value={s.id}>{s.label}</option>)}
          </select>
        </label>
        <button type="button" class="slds-btn" data-action="become-sofia">Become Sofia</button>
      </div>

      <h3 class="sub">Persona presets</h3>
      <p class="help">Starts over as Sofia at a life stage, with her earlier affinities loaded, so a story can begin mid-journey. Also accepts cookies if needed.</p>
      <div class="buttons">
        <button type="button" class="slds-btn" data-preset="anonymous">Anonymous</button>
        {stages.map((s) => <button type="button" class="slds-btn" data-preset={s.id}>{presetLabels[s.id] ?? s.label}</button>)}
      </div>
    </section>

    <section class="card">
      <h2>Data 360 inspector</h2>
      <div class="buttons">
        <a class="slds-btn" href="/data360/" target="cu-data360" data-open-companion>Open /data360 companion window</a>
      </div>
      <p class="help">The inspector drawer is on every site page: click the blue <b>Data 360</b> tab on the right edge, or press <kbd>Ctrl</kbd> + <kbd>Alt</kbd> + <kbd>I</kbd>. It stays open as you move between pages.</p>
      <h3 class="sub">Affinity tuner</h3>
      <p class="help">
        How many points each action adds to every matching affinity, and how many points each personalization rule needs.
        Saved in this browser and applied live to open site tabs. New weights apply to new activity; points already earned stay.
      </p>
      <div class="tuner">
        <div class="table-scroll">
          <table>
            <caption>Points per action</caption>
            <thead><tr><th scope="col">Action</th><th scope="col">Points</th><th scope="col">Default</th></tr></thead>
            <tbody>
              {weightRows.map((w) => (
                <tr data-tuner-row>
                  <th scope="row"><label for={`tune-w-${w.key}`}>{w.label}</label></th>
                  <td><input id={`tune-w-${w.key}`} type="number" inputmode="numeric" min="0" max="50" step="1" data-weight={w.key} data-default={w.dflt} /></td>
                  <td>{w.dflt}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="table-scroll">
          <table>
            <caption>Points a rule needs</caption>
            <thead><tr><th scope="col">Rule</th><th scope="col">Needs</th><th scope="col">Default</th></tr></thead>
            <tbody>
              {thresholdRows.map((r) => (
                <tr data-tuner-row>
                  <th scope="row">
                    <label for={`tune-t-${r.id}`}>{r.zone}: <b>{r.variant}</b></label>
                    <span class="tuner__signal">{r.signal} · <code>{r.id}</code></span>
                  </th>
                  <td><input id={`tune-t-${r.id}`} type="number" inputmode="numeric" min="1" max="50" step="1" data-threshold={r.id} data-default={r.dflt} /></td>
                  <td>{r.dflt}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p><button type="button" class="slds-btn" data-action="reset-tuner">Restore tuner defaults</button></p>
    </section>

    <section class="card">
      <h2>Config readout</h2>
      <div class="table-scroll">
        <table>
          <tbody>
            <tr><th scope="row">Qualified (Piper)</th><td><span class="pill">Not loaded by the site</span> added during demos with a Chrome extension</td></tr>
            <tr><th scope="row">Agentforce</th><td><span class="pill pill--ok">Simulated</span> client-side mock, no embed ID needed</td></tr>
            <tr><th scope="row">Data 360 / Personalization</th><td><span class="pill pill--ok">Simulated</span> client-side, no SDK</td></tr>
          </tbody>
        </table>
      </div>
      <h3 class="sub">URL overrides in this tab</h3>
      <p class="help">
        Add <code>?agentforce=1</code>, <code>?agent=student-success</code>,
        <code>?sim=0</code>, <code>?badge=0</code>, <code>?autoconsent=1</code>, <code>?match=typed</code>, <code>?why=0</code> or <code>?grounding=0</code> to any page URL. Overrides last for that
        browser tab and beat the saved settings above.
      </p>
      <pre id="overrides">none</pre>
      <p><button type="button" class="slds-btn" data-action="clear-overrides">Clear URL overrides</button></p>
      <h3 class="sub">Effective settings</h3>
      <pre id="effective"></pre>
    </section>

    <section class="card">
      <h2>Shortcuts</h2>
      <p class="help"><kbd>Ctrl</kbd> + <kbd>Alt</kbd> + <kbd>D</kbd> on any site page opens this panel.</p>
      <p class="help"><kbd>Ctrl</kbd> + <kbd>Alt</kbd> + <kbd>I</kbd> on any site page opens or closes the Data 360 inspector drawer.</p>
    </section>
  </main>
  <script type="application/json" id="cu-sim-catalog" set:html={simCatalog} />
</ToolLayout>

<style>
  .status:empty {
    display: none;
  }
  .status {
    background: #e3f3e6;
    border: 1px solid #91db8b;
    color: #194e31;
    border-radius: 0.25rem;
    padding: 0.6rem 1rem;
  }
  .controls {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .switch,
  .radio-group label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .switch input,
  .radio-group input {
    margin-top: 0.25rem;
  }
  .radio-group {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }
  .radio-group legend {
    padding: 0;
    margin-bottom: 0.4rem;
  }
  .select {
    display: grid;
    gap: 0.35rem;
    max-width: 360px;
  }
  .select select {
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--slds-border);
    border-radius: 0.25rem;
    background: #fff;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  h3.sub {
    font-size: 0.9rem;
    margin: 1.1rem 0 0.5rem;
  }
  .tuner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .tuner caption {
    text-align: left;
    font-weight: 700;
    padding-bottom: 0.35rem;
  }
  .tuner th[scope='row'] {
    font-weight: 400;
  }
  .tuner input {
    width: 4.5rem;
    font: inherit;
    padding: 0.2rem 0.35rem;
    border: 1px solid var(--slds-border);
    border-radius: 4px;
  }
  .tuner tr.is-changed input {
    border-color: #dd7a01;
    background: #fef1e4;
  }
  .tuner__signal {
    display: block;
    font-size: 0.8rem;
    color: #5c5c5c;
  }
  kbd {
    border: 1px solid var(--slds-border);
    border-bottom-width: 2px;
    border-radius: 3px;
    padding: 0 0.35rem;
    background: #fff;
    font-size: 0.85em;
  }
</style>

<script>
  import {
    captureUrlOverrides,
    getSettings,
    getOverrides,
    getSaved,
    saveSettings,
    resetSettings,
    clearOverrides,
    onSettingsChange,
  } from '../scripts/settings.js';
  import { getConsent, clearConsent, setConsent } from '../scripts/consent.js';
  import * as store from '../../sim/store.js';
  import { stitch, loadPreset, fullName, STAGES, displayName } from '../../sim/identity.js';

  let catalog = {};
  try {
    catalog = JSON.parse(document.getElementById('cu-sim-catalog')?.textContent || '{}');
  } catch {}
  store.startSync();
  import { resolveAgent } from '../scripts/widgets.js';
  import { AGENT_PERSONAS } from '../lib/taxonomy.js';

  captureUrlOverrides();

  const $ = (sel: string) => document.querySelector(sel) as HTMLElement;
  const status = $('#status');
  let statusTimer: number | undefined;
  function say(msg: string) {
    status.textContent = msg;
    clearTimeout(statusTimer);
    statusTimer = window.setTimeout(() => (status.textContent = ''), 3000);
  }

  // "Back to site" returns to the page the presenter came from.
  try {
    const ref = document.referrer && new URL(document.referrer);
    if (ref && ref.origin === location.origin && !ref.pathname.startsWith('/demo')) {
      ($('#back-link') as HTMLAnchorElement).href = ref.pathname + ref.search;
    }
  } catch {}

  const yes = '<span class="pill pill--ok">shown</span>';
  const no = '<span class="pill">hidden</span>';

  function render() {
    const s = getSettings();
    const overrides = getOverrides();

    document.querySelectorAll<HTMLInputElement>('input[type=checkbox][data-setting]').forEach((input) => {
      input.checked = Boolean(s[input.dataset.setting as keyof typeof s]);
    });
    ($('select[data-setting=agentPersona]') as HTMLSelectElement).value = s.agentPersona;
    document.querySelectorAll<HTMLElement>('[data-override-for]').forEach((pill) => {
      pill.hidden = !pill.dataset.overrideFor!.split(',').some((key) => key in overrides);
    });

    document.querySelectorAll<HTMLTableRowElement>('#routing tr').forEach((row) => {
      const plan = resolveAgent(row.dataset.audience, s);
      row.cells[1].innerHTML = plan.agentforce ? `${yes} bottom-right` : no;
      row.cells[2].textContent = plan.agentforce ? AGENT_PERSONAS[plan.agentPersona as keyof typeof AGENT_PERSONAS] : '–';
    });

    const consent = getConsent();
    const consentEl = $('#consent-state');
    consentEl.textContent = consent ?? 'not answered';
    consentEl.className = `pill ${consent === 'all' ? 'pill--ok' : 'pill--warn'}`;

    const sim = store.getState();
    const visitorEl = $('#visitor-state');
    visitorEl.textContent = sim.identity?.known
      ? `${displayName(sim.identity)} · ${sim.identity.personId === 'sofia' ? STAGES[sim.identity.stage] : 'New contact'}`
      : `Anonymous · ${sim.events.length} engagement ${sim.events.length === 1 ? 'row' : 'rows'}`;
    document.querySelectorAll<HTMLInputElement>('input[name=identityMatching]').forEach((r) => {
      r.checked = r.value === s.identityMatching;
    });
    visitorEl.className = `pill ${sim.identity?.known ? 'pill--ok' : ''}`;

    // Affinity tuner: effective values; a changed value is highlighted. Leave the field being typed in alone.
    document.querySelectorAll<HTMLInputElement>('input[data-weight], input[data-threshold]').forEach((input) => {
      const table = input.dataset.weight ? s.weights : s.thresholds;
      const key = (input.dataset.weight ?? input.dataset.threshold)!;
      const value = table?.[key] ?? Number(input.dataset.default);
      if (document.activeElement !== input) input.value = String(value);
      input.closest('tr')!.classList.toggle('is-changed', key in (table ?? {}));
    });

    $('#overrides').textContent = Object.keys(overrides).length ? JSON.stringify(overrides, null, 2) : 'none';
    $('#effective').textContent = JSON.stringify(s, null, 2);
  }

  document.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement | HTMLSelectElement;
    if (t instanceof HTMLInputElement && t.type === 'checkbox' && t.dataset.setting) {
      saveSettings({ [t.dataset.setting]: t.checked });
    } else if (t instanceof HTMLInputElement && (t.dataset.weight || t.dataset.threshold)) {
      const isWeight = Boolean(t.dataset.weight);
      const key = (t.dataset.weight ?? t.dataset.threshold)!;
      const min = isWeight ? 0 : 1;
      const dflt = Number(t.dataset.default);
      const n = Math.round(Number(t.value));
      const value = Number.isFinite(n) && t.value.trim() !== '' ? Math.min(50, Math.max(min, n)) : dflt;
      const field = isWeight ? 'weights' : 'thresholds';
      const next = { ...(getSaved()[field] ?? {}) };
      if (value === dflt) delete next[key];
      else next[key] = value;
      t.value = String(value);
      saveSettings({ [field]: next });
    } else if (t instanceof HTMLInputElement && t.name === 'identityMatching') {
      saveSettings({ identityMatching: t.value });
    } else if (t instanceof HTMLSelectElement && t.dataset.setting === 'agentPersona') {
      saveSettings({ agentPersona: t.value });
    } else return;
    say('Saved. Open site tabs update automatically.');
  });

  document.addEventListener('click', (e) => {
    const action = (e.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset.action;
    if (action === 'reset-settings') {
      resetSettings();
      say('Settings restored to defaults.');
    } else if (action === 'reset-tuner') {
      saveSettings({ weights: {}, thresholds: {} });
      say('Tuner restored to the defaults.');
    } else if (action === 'clear-overrides') {
      clearOverrides();
      history.replaceState(null, '', location.pathname);
      say('URL overrides cleared for this tab.');
    } else if (action === 'clear-consent') {
      clearConsent();
      render();
      say('Consent cleared. The banner shows on the next page load.');
    } else if (action === 'reset-visitor') {
      try {
        Object.keys(localStorage)
          .filter((k) => k.startsWith('cu_sim'))
          .forEach((k) => localStorage.removeItem(k));
      } catch {}
      store.reset();
      clearConsent();
      render();
      say('Visitor reset: simulated profile and consent cleared.');
    } else if (action === 'become-sofia') {
      const stage = (document.getElementById('become-stage') as HTMLSelectElement).value;
      if (getConsent() !== 'all') setConsent('all');
      stitch({ stage, via: 'Become Sofia (demo panel)' });
      render();
      say(`Stitched to ${fullName}, ${STAGES[stage]}. Open site tabs update automatically.`);
    }
    const preset = (e.target as HTMLElement).closest<HTMLElement>('[data-preset]')?.dataset.preset;
    if (preset === 'anonymous') {
      store.reset();
      render();
      say('Preset loaded: a new anonymous visitor.');
    } else if (preset) {
      if (getConsent() !== 'all') setConsent('all');
      loadPreset(preset, catalog);
      render();
      say(`Preset loaded: ${fullName}, ${STAGES[preset]}.`);
    }
  });

  // Reuse one named companion window so repeated clicks don't stack windows.
  document.querySelectorAll<HTMLAnchorElement>('[data-open-companion]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      window.open(a.href, 'cu-data360', 'popup,width=1100,height=800')?.focus();
    }),
  );

  onSettingsChange(render);
  store.subscribe(() => render());
  window.addEventListener('focus', render);
  render();
</script>
