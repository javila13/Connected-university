---
// Renders every Markdown page in content/pages. Optional frontmatter adds
// program cards (listPrograms), the faculty directory (listFaculty),
// certificate cards (listCertificates), team cards (listTeams), the full
// schedule (listSchedule), news cards (listNews), the pz-next-credential zone
// (nextCredential), event cards (listEvents), a demo form (form), an FAQ
// block and the pz-giving-cta
// zone (givingCta). A block marker on its own line in the Markdown places a
// component at that spot: `<!-- cost-table -->`, `<!-- society-join -->` or
// `<!-- certificate-pathways -->`. A section hub (a page whose route is a
// top-level nav item) also lists the section's live child pages.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProgramCards from '../components/ProgramCards.astro';
import FacultyCards from '../components/FacultyCards.astro';
import Faq from '../components/Faq.astro';
import CostTable from '../components/CostTable.astro';
import DemoForm from '../components/DemoForm.astro';
import GivingCta from '../components/GivingCta.astro';
import GiftForm from '../components/GiftForm.astro';
import SocietyJoin from '../components/SocietyJoin.astro';
import CertificatePathways from '../components/CertificatePathways.astro';
import CertificateCards from '../components/CertificateCards.astro';
import NextCredential from '../components/NextCredential.astro';
import CeInquiryForm from '../components/CeInquiryForm.astro';
import TeamCards from '../components/TeamCards.astro';
import ScheduleTable from '../components/ScheduleTable.astro';
import NewsCards from '../components/NewsCards.astro';
import TicketsForm from '../components/TicketsForm.astro';
import RecruitForm from '../components/RecruitForm.astro';
import EventCards from '../components/EventCards.astro';
import VisitForm from '../components/VisitForm.astro';
import { allGames } from '../lib/athletics.js';
import { hubChildren } from '../lib/routes.js';
import { programsFor, groupBySchool } from '../lib/academics.js';
import { fillFacts } from '../lib/fill-facts.js';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const where = `content/pages/${entry.id}`;
const html = fillFacts(entry.rendered?.html ?? '', where, { html: true });
// Even indexes are HTML, odd indexes are block names.
const BLOCKS = { 'cost-table': CostTable, 'society-join': SocietyJoin, 'certificate-pathways': CertificatePathways };
const parts = html.split(/<!-- (cost-table|society-join|certificate-pathways) -->/);
const description = fillFacts(d.description, where);
const children = await hubChildren(`/${entry.id}/`);

const programs = d.listPrograms ? await programsFor(d.listPrograms) : [];
const groups = d.listGroupBySchool ? groupBySchool(programs) : [];
// Faculty directory is A to Z by last name.
const lastName = (p) => p.data.name.split(' ').at(-1);
const people = d.listFaculty
  ? (await getCollection('faculty')).sort((a, b) => lastName(a).localeCompare(lastName(b)))
  : [];
const certificates = d.listCertificates
  ? (await getCollection('certificates')).sort((a, b) => a.data.shortTitle.localeCompare(b.data.shortTitle))
  : [];
const teams = d.listTeams
  ? (await getCollection('teams')).sort((a, b) => a.data.name.localeCompare(b.data.name))
  : [];
const games = d.listSchedule ? await allGames() : [];
const news = d.listNews
  ? (await getCollection('news'))
      .filter((n) => d.listNews === 'all' || n.data.category === d.listNews)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  : [];
const events = d.listEvents
  ? (await getCollection('events')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  : [];
const FORMS = { give: GiftForm, 'ce-inquiry': CeInquiryForm, tickets: TicketsForm, recruit: RecruitForm, visit: VisitForm };
const FormComponent = d.form ? FORMS[d.form as keyof typeof FORMS] : undefined;
---
<BaseLayout
  title={d.title}
  description={description}
  section={d.section}
  audience={d.audience}
  program={d.program}
  topic={d.topic}
  personaHook={d.personaHook}
>
  <PageHero title={d.title} lede={description} eyebrow={d.eyebrow} />
  <div class="wrap">
    <article class="prose">
      {parts.map((part, i) => {
        if (i % 2 === 0) return <Fragment set:html={part} />;
        const Block = BLOCKS[part as keyof typeof BLOCKS];
        return <Block />;
      })}
    </article>
    {children.length > 0 && (
      <nav aria-label={`${d.title} pages`}>
        <ul class="link-grid">
          {children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </nav>
    )}
    {d.nextCredential && <NextCredential />}
    {certificates.length > 0 && (
      <section class="listing" aria-labelledby="certificates-heading">
        <h2 id="certificates-heading">{d.listHeading ?? 'Certificates'}</h2>
        <CertificateCards items={certificates} />
      </section>
    )}
    {teams.length > 0 && (
      <section class="listing" aria-labelledby="teams-heading">
        <h2 id="teams-heading">{d.listHeading ?? 'Teams'}</h2>
        <TeamCards items={teams} />
      </section>
    )}
    {games.length > 0 && (
      <section class="listing" aria-labelledby="schedule-heading">
        <h2 id="schedule-heading">{d.listHeading ?? 'Schedule'}</h2>
        <ScheduleTable games={games} showTeam />
      </section>
    )}
    {news.length > 0 && (
      <section class="listing" aria-labelledby="news-heading">
        <h2 id="news-heading">{d.listHeading ?? 'Latest news'}</h2>
        <NewsCards items={news} />
      </section>
    )}
    {events.length > 0 && (
      <section class="listing" aria-labelledby="events-heading">
        <h2 id="events-heading">{d.listHeading ?? 'Upcoming events'}</h2>
        <EventCards items={events} />
      </section>
    )}
    {FormComponent && <FormComponent />}
    {d.form && !FormComponent && <DemoForm kind={d.form as 'request-info' | 'apply' | 'update-info'} />}
    {programs.length > 0 && (
      <section class="listing" aria-labelledby="programs-heading">
        <h2 id="programs-heading">{d.listHeading ?? 'Programs'}</h2>
        {groups.length > 0
          ? groups.map((g) => (
              <div class="listing__group">
                <h3>{g.school.name}</h3>
                <ProgramCards items={g.items} showSchool={false} />
              </div>
            ))
          : <ProgramCards items={programs} />}
      </section>
    )}
    {people.length > 0 && (
      <section class="listing" aria-labelledby="faculty-heading">
        <h2 id="faculty-heading">{d.listHeading ?? 'Faculty'}</h2>
        <FacultyCards people={people} />
      </section>
    )}
    <Faq faqs={d.faqs} where={where} />
  </div>
  {d.givingCta && <GivingCta />}
</BaseLayout>
