---
import Logo from './Logo.astro';
import { getNav } from '../lib/routes.js';

interface Props {
  section: string;
}
const { section } = Astro.props;
const nav = await getNav();
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---
<div class="utility-bar">
  <div class="wrap">
    <nav aria-label="Utility">
      <ul>
        {nav.utility.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <ul class="portal-links">
      <li><a href="/portal/">Student Portal</a></li>
      <li>
        <a href="#" data-inert-link aria-disabled="true" title="Not available in this demo">Professor Login</a>
      </li>
    </ul>
  </div>
</div>
<header class="site-header" data-section={section}>
  <div class="wrap site-header__inner">
    <Logo />
    <nav class="main-nav" id="main-nav" aria-label="Main">
      <ul>
        {nav.main.map((item) => (
          <li class:list={{ 'is-active': isActive(item.href) }}>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            {item.children.length > 0 && (
              <ul class="submenu">
                {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <button class="search-toggle" type="button" aria-expanded="false" aria-controls="site-search" data-search-toggle>
      <span class="visually-hidden">Search</span>
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13Zm4.7-1.8L20 20"/></svg>
    </button>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg>
    </button>
  </div>
  <div class="search-panel" id="site-search" hidden>
    <form class="wrap search-panel__form" action="/search/" method="get" role="search">
      <label for="site-search-q" class="visually-hidden">Search Connected University</label>
      <input id="site-search-q" name="q" type="search" placeholder="What are you looking for?" autocomplete="off" enterkeyhint="search" />
      <button class="btn btn--navy" type="submit">Search</button>
    </form>
  </div>
</header>
