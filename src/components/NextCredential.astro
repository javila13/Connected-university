---
// Personalization zone pz-next-credential (PLAN.md §5.4): the Continuing Ed
// catalog tile. The default variant features the certificate marked
// `featured: true`. Phase 2's rules swap it for a credential holder; for
// Sofia, the MBA with a Sustainable Business focus (Jesse, 2026-11-06).
import { getCollection, getEntry } from 'astro:content';
import { certificateUrl, programUrl, pickLive } from '../lib/routes.js';

const all = await getCollection('certificates');
const featured = all.filter((c) => c.data.featured);
if (featured.length !== 1) {
  throw new Error(`[certificates] exactly one certificate needs featured: true (found ${featured.length})`);
}
const cert = featured[0];
const pathway = cert.data.pathway ? await getEntry(cert.data.pathway.program) : null;
const inquiry = await pickLive('/continuing-ed/inquiry/', '/continuing-ed/');
---
<section
  id="pz-next-credential"
  class="next-credential"
  data-pz-zone="pz-next-credential"
  data-pz-variant="default"
  aria-labelledby="next-credential-heading"
>
  <p class="eyebrow">Featured certificate</p>
  <h2 id="next-credential-heading">{cert.data.title}</h2>
  <p>{cert.data.description}</p>
  <p class="next-credential__meta">
    {cert.data.courses.length} courses · {cert.data.length} · starts {cert.data.startTerms.join(', ')}
  </p>
  {cert.data.pathway && pathway && (
    <p class="next-credential__meta">
      Its {cert.data.credits} graduate credits count toward the <a href={programUrl(pathway.id)}>{cert.data.pathway.credential}</a>{cert.data.pathway.focus ? ` (${cert.data.pathway.focus} focus)` : ''}.
    </p>
  )}
  <div class="next-credential__actions">
    <a class="btn btn--gold" href={certificateUrl(cert.id)} data-cta="next-credential">Explore the certificate</a>
    <a class="btn btn--ghost" href={`${inquiry}?interest=${cert.id}`} data-cta="ce-inquiry">Request Information</a>
  </div>
</section>
