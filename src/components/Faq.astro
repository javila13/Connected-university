---
// FAQ block plus schema.org FAQPage data. The questions are plain page text,
// so Piper's crawl, site search and the Phase 2 agent mock all read them.
import { fillFacts } from '../lib/fill-facts.js';

interface Props {
  faqs?: { q: string; a: string }[];
  where: string;
  heading?: string;
}
const { faqs = [], where, heading = 'Frequently asked questions' } = Astro.props;
const items = faqs.map((f) => ({ q: fillFacts(f.q, where), a: fillFacts(f.a, where) }));
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}).replace(/</g, '\\u003c');
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">{heading}</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </section>
)}
