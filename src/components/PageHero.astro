---
// Page title band. Breadcrumbs show on pages below a section hub.
import { getCrumbs } from '../lib/routes.js';

interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
}
const { title, lede, eyebrow } = Astro.props;
const crumbs = await getCrumbs(Astro.url.pathname);
---
<section class="page-hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</section>
